ENV=DEVELOPMENT
PORT=8000
DATABASE=mongodb+srv://your_user:your_password@cluster0.xxxxx.mongodb.net/cipherchat
# SECRET must be a random string of at least 32 characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=replace-this-with-a-64-char-hex-string-generated-by-crypto-randomBytes
FRONTEND_URL=https://your-frontend-url.onrender.com
LOG_LEVEL=info
