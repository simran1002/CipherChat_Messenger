# Dev: leave VITE_API_URL unset — the Vite proxy forwards the API and the STOMP /ws
# endpoint to the backend (override target with VITE_DEV_API_TARGET, port with VITE_PORT).
# Production images bake it at build time (Docker build arg). A bare hostname is accepted
# and becomes https://host, which is what a Render blueprint injects via fromService … host.
# VITE_API_URL=http://localhost:8080
